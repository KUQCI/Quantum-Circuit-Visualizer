            "kind": "circuit",
            "qubits": 1,
            "gates": [
              {
                "gate": "h",
                "targets": [0]
              },
              {
                "gate": "z",
                "targets": [0]
              }
            ],
            "reveal": 0,
            "add": 2,
            "panels": ["bloch", "phase"]
          }
        },
        {
          "id": "bell-state",
          "caption": "The Bell circuit shares probability between 00 and 11.",
          "speech": "The Bell circuit shares probability between zero zero and one one.",
          "scene": {
            "kind": "circuit",
            "qubits": 2,
            "gates": [
              {
                "gate": "h",
                "targets": [0]
